[Unit]
Description=Katana - receptor de nodos Atalaya (TCP 8300)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alexis
WorkingDirectory=/home/alexis/katana-servidor
ExecStart=/usr/bin/python3 -I /home/alexis/katana-servidor/receptor.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

#!/usr/bin/env python3
"""Puente USB <-> servidor para la pantalla Atalaya (UNO R4 Minima, sin WiFi).

La pantalla queda conectada por USB al servidor local (Katana). Este puente:
  - lee las lineas JSON que emite la pantalla y las reenvia al receptor TCP de placas (puerto 8300),
    con el mismo protocolo que usaba la R4 WiFi (primera linea "TOKEN <token>");
  - pasa a la pantalla las ordenes del servidor (HORA, SYNC);
  - le avisa a la pantalla el estado del enlace con "RED 3" (enlazado) o "RED 2" (sin servidor);
  - se reconecta solo si se cae el servidor o se desenchufa la pantalla.

Token: variable PLACA_TOKEN o --token-archivo con una linea PLACA_TOKEN=... (no se imprime nunca).
Uso: python3 puente_pantalla.py --servidor 127.0.0.1 --token-archivo ~/atalaya.env
"""
import argparse
import os
import socket
import sys
import threading
import time

VID_ARDUINO = 0x2341
RED_SIN_SERVIDOR = 2
RED_ENLAZADO = 3


def debe_reenviar(linea: str) -> bool:
    """Solo JSON hacia el servidor; la posicion del dedo ({"p":...}) y las capturas quedan en USB."""
    linea = linea.strip()
    return linea.startswith("{") and not linea.startswith('{"p"')


def lee_token(archivo, entorno=os.environ):
    if entorno.get("PLACA_TOKEN"):
        return entorno["PLACA_TOKEN"].strip()
    if archivo:
        with open(os.path.expanduser(archivo), encoding="utf-8") as f:
            for linea in f:
                clave, _, valor = linea.strip().partition("=")
                if clave.strip() == "PLACA_TOKEN" and valor.strip():
                    return valor.strip().strip('"').strip("'")
    return ""


def busca_puerto(preferido=None):
    if preferido:
        return preferido
    from serial.tools import list_ports
    placas = [p for p in list_ports.comports() if p.vid == VID_ARDUINO]
    minima = [p for p in placas if "minima" in (p.description or "").lower() or p.pid == 0x0069]
    elegido = (minima or placas or [None])[0]
    return elegido.device if elegido else None


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


class Puente:
    def __init__(self, puerto, servidor, puerto_tcp, token):
        self.puerto, self.servidor, self.puerto_tcp, self.token = puerto, servidor, puerto_tcp, token
        self.ser = None
        self.sock = None
        self.lock_ser = threading.Lock()
        self.lock_sock = threading.Lock()
        self.vivo = True

    # ---- hacia la pantalla ----
    def a_pantalla(self, texto):
        with self.lock_ser:
            if self.ser is None:
                return
            try:
                self.ser.write((texto + "\n").encode())
            except Exception:
                self.ser = None

    def red(self):
        return RED_ENLAZADO if self.sock else RED_SIN_SERVIDOR

    # ---- hacia el servidor ----
    def a_servidor(self, linea):
        with self.lock_sock:
            if self.sock is None:
                return
            try:
                self.sock.sendall((linea.strip() + "\n").encode())
            except OSError:
                self._cierra_sock()

    def _cierra_sock(self):
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None
            log("servidor desconectado")
            self.a_pantalla(f"RED {RED_SIN_SERVIDOR}")

    # ---- hilos ----
    def hilo_serie(self):
        import serial
        while self.vivo:
            puerto = busca_puerto(self.puerto)
            if not puerto:
                time.sleep(2)
                continue
            try:
                s = serial.Serial(puerto, 115200, timeout=1)
            except Exception as e:
                log(f"no se pudo abrir {puerto}: {e}")
                time.sleep(2)
                continue
            with self.lock_ser:
                self.ser = s
            log(f"pantalla abierta en {puerto}")
            self.a_pantalla(f"HORA {int(time.time())}")
            self.a_pantalla(f"RED {self.red()}")
            if self.sock:
                self.a_pantalla("SYNC")
            buf = b""
            while self.vivo and self.ser is s:
                try:
                    trozo = s.read(512)
                except Exception:
                    break
                buf += trozo
                while b"\n" in buf:
                    linea, buf = buf.split(b"\n", 1)
                    texto = linea.decode("utf-8", "replace")
                    if debe_reenviar(texto):
                        self.a_servidor(texto)
            log("pantalla desconectada")
            with self.lock_ser:
                self.ser = None
            try:
                s.close()
            except Exception:
                pass
            time.sleep(1)

    def hilo_servidor(self):
        espera = 2
        while self.vivo:
            try:
                sock = socket.create_connection((self.servidor, self.puerto_tcp), timeout=5)
            except OSError as e:
                log(f"sin servidor {self.servidor}:{self.puerto_tcp} ({e}); reintento en {espera}s")
                time.sleep(espera)
                espera = min(espera * 2, 60)
                continue
            espera = 2
            sock.settimeout(None)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
            sock.sendall(f"TOKEN {self.token}\n".encode())
            with self.lock_sock:
                self.sock = sock
            log(f"enlazado con {self.servidor}:{self.puerto_tcp}")
            self.a_pantalla(f"RED {RED_ENLAZADO}")
            buf = b""
            while self.vivo:
                try:
                    trozo = sock.recv(1024)
                except OSError:
                    trozo = b""
                if not trozo:
                    break
                buf += trozo
                while b"\n" in buf:
                    linea, buf = buf.split(b"\n", 1)
                    orden = linea.decode("utf-8", "replace").strip()
                    if orden.startswith("HORA ") or orden == "SYNC":
                        self.a_pantalla(orden)
            with self.lock_sock:
                if self.sock is sock:
                    self._cierra_sock()
            time.sleep(2)

    def hilo_aviso(self):
        while self.vivo:            # si la pantalla se reinicia, vuelve a saber el estado del enlace
            time.sleep(15)
            self.a_pantalla(f"RED {self.red()}")

    def corre(self):
        for h in (self.hilo_serie, self.hilo_servidor, self.hilo_aviso):
            threading.Thread(target=h, daemon=True).start()
        try:
            while True:
                time.sleep(3600)
        except KeyboardInterrupt:
            self.vivo = False


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--puerto", help="puerto serie (por defecto, busca la R4 Minima)")
    ap.add_argument("--servidor", default="127.0.0.1", help="IP del receptor de placas (Katana)")
    ap.add_argument("--puerto-tcp", type=int, default=8300)
    ap.add_argument("--token-archivo", help="archivo con PLACA_TOKEN=...")
    a = ap.parse_args(argv)
    token = lee_token(a.token_archivo)
    if not token:
        sys.exit("falta el token: define PLACA_TOKEN o usa --token-archivo")
    log(f"puente pantalla -> {a.servidor}:{a.puerto_tcp}")
    Puente(a.puerto, a.servidor, a.puerto_tcp, token).corre()


if __name__ == "__main__":
    main()

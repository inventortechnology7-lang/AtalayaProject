# Generate credentials: python3 scripts/init-env.py (never overwrites .env).
DB_PASSWORD=replace-with-random-32-characters
ADMIN_EMAIL=admin@katana.local
ADMIN_PASSWORD=replace-with-random-32-characters
PLACA_TOKEN=replace-with-provisioned-device-token
KATANA_WEB_PORT=28082
KATANA_API_PORT=28080
KATANA_TCP_PORT=8300
# Bind to the laptop LAN IP for phones and nodes; restrict via host firewall.
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1
TCP_BIND=127.0.0.1
# Actual source IP of USB bridge as seen by Docker (usually bridge gateway).
PANTALLA_ORIGEN=127.0.0.1,::1
RECOVER_IMPORTED_ADMIN=false

ADMIN_EMAIL=admin@atalaya.local
ADMIN_PASSWORD=replace-with-random-32-characters
SYNC_USUARIO=edge@atalaya.local
SYNC_CLAVE=replace-with-another-random-secret
PLACA_TOKEN=replace-with-provisioned-device-token
